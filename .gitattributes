# Normalise line endings inside the repository; check out native per platform.
# Without this, every file edited on Windows shows as fully rewritten in a diff.
* text=auto

# Never touch these
*.png      binary
*.pbix     binary
*.duckdb   binary
*.xlsx     binary
*.parquet  binary

# Notebooks and SQL stay LF so diffs and CI behave identically everywhere
*.ipynb    text eol=lf
*.sql      text eol=lf
*.yml      text eol=lf

# Language statistics. One exploratory notebook is 4,646 lines against 951 of
# SQL and 1,121 of Python, so GitHub reported this as a 92% Jupyter Notebook
# repository. Marking it as documentation excludes it from the language bar
# without hiding the file.
*.ipynb         linguist-documentation
data/sample/**  linguist-generated
